{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "long-band-f777",
  "account_id": "ebc0b4333cda21b22deca8e42ad8a56d",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "routes": [
    { "pattern": "royalduckusa.com", "custom_domain": true },
    { "pattern": "www.royalduckusa.com", "custom_domain": true }
  ],
  "assets": { "directory": "./dist", "binding": "ASSETS", "html_handling": "auto-trailing-slash", "not_found_handling": "none", "run_worker_first": ["/api/auth/*", "/admin", "/admin/*"] },
  "vars": { "SITE_ENV": "production", "ADMIN_ORIGIN": "https://little-river-fc26.halona-zhao.workers.dev", "GITHUB_REPOSITORY": "halonazhao/royal-duck-website" }
}
